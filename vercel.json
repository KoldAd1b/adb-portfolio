{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/lab",
      "destination": "/lab.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/esoterica",
      "destination": "/esoterica.html"
    },
    {
      "source": "/esoterica/maya",
      "destination": "/esoterica/maya.html"
    },
    {
      "source": "/academia",
      "destination": "/academia.html"
    },
    {
      "source": "/academia/vae-elbo",
      "destination": "/academia/vae-elbo.html"
    },
    {
      "source": "/academia/diffusion",
      "destination": "/academia/diffusion.html"
    },
    {
      "source": "/academia/fokker-planck",
      "destination": "/academia/fokker-planck.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    }
  ],
  "redirects": [
    {
      "source": "/work",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/project",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/case/:path*",
      "destination": "/",
      "permanent": false
    }
  ]
}
